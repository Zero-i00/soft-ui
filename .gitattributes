# Normalise line endings for all text files on checkout
* text=auto eol=lf
*.sh text eol=lf

# Binary — never diff or convert line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.tar.gz binary

# Tell GitHub linguist to ignore generated/vendored files
# so they don't skew the repo's language stats
pnpm-lock.yaml linguist-generated=true
*.min.js linguist-generated=true
*.min.css linguist-generated=true
packages/primitives/dist/** linguist-generated=true

# Exclude from `git archive` / GitHub's Download ZIP
.gitattributes export-ignore
.gitignore export-ignore
.husky/ export-ignore
.changeset/ export-ignore
docs/ export-ignore
commitlint.config.ts export-ignore
biome.json export-ignore
turbo.json export-ignore
