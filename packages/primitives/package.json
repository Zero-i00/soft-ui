{
	"name": "@soft-ui/primitives",
	"version": "0.0.0",
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "rslib build",
		"dev": "rslib build --watch",
		"lint": "oxlint src",
		"typecheck": "tsgo --noEmit",
		"test": "rstest run",
		"clean": "rm -rf dist .turbo"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	},
	"devDependencies": {
		"@rsbuild/plugin-react": "^2.1.0",
		"@rslib/core": "^0.23.2",
		"@rstest/core": "^0.11.3",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^18.3.0",
		"@types/react-dom": "^18.3.0",
		"jsdom": "^29.0.2",
		"react": "^18.3.0",
		"react-dom": "^18.3.0",
		"typescript": "^5.6.0"
	}
}
